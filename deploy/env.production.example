# deploy/env.production.example
#
# VPS上の backend/.env のひな形。
# DATABASE_URL / DATABASE_URL_MASTER の2つだけ、setup-vps.sh で作成した
# PostgreSQLのユーザー名・パスワード・DB名に書き換えてください。
# それ以外の値は、今お使いのローカルPCの backend/.env の値をそのままコピーしてください
# (LINE・Gemini・OpenRouterの各キーはホストに依存しないため)。

# --- ここはVPS用に書き換える ---
DATABASE_URL="postgresql://garage:選んだパスワード@localhost:5432/dream_garage_lite"
DATABASE_URL_MASTER="postgresql://garage:選んだパスワード@localhost:5432/dream_garage_master"

# --- ここから下は、今のローカルの.envの値をそのままコピーする ---
SESSION_JWT_SECRET="ここは移行のタイミングで新しいランダム値に差し替えることを推奨"
ADMIN_PASSWORD="(ローカルの値をコピー)"
GOOGLE_API_KEY="(ローカルの値をコピー)"
OPENROUTER_API_KEY="(ローカルの値をコピー)"
OPENROUTER_MODEL="openai/gpt-4o-mini"
LINE_CHANNEL_ID="(ローカルの値をコピー)"
LINE_CHANNEL_SECRET="(ローカルの値をコピー)"
LINE_CHANNEL_ACCESS_TOKEN="(ローカルの値をコピー)"
PUBLIC_API_URL="https://api.dreamgaragelite.com/api"
PUBLIC_APP_URL="https://app.dreamgaragelite.com"
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="https://api.dreamgaragelite.com/api/google-calendar/oauth/callback"

# デモプレイ版の「エラー報告」ボタンの通知先(運営者本人のLINEユーザーID、ローカルの値をコピー)
SYSTEM_ADMIN_LINE_USER_ID="(ローカルの値をコピー)"

# 顧客用ポータル(LIFF)。Messaging APIチャネルとは別の「LINEログイン」チャネルのChannel ID(ローカルの値をコピー)
LIFF_CHANNEL_ID="(ローカルの値をコピー)"
