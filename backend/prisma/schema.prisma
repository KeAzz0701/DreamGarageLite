generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  LITE
  STANDARD
  PRO
  ENTERPRISE
  DEMO
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum LicenseStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  E_MONEY
  CARRIER_BILLING
}

enum PlanChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EstimateCategory {
  SHAKEN
  GENERAL
}

enum VehicleCategory {
  KEI
  REGULAR
  LARGE
  CARGO
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

model Company {
  id            Int      @id @default(autoincrement())
  name          String
  companyName   String?
  email         String?
  phone         String?
  address       String?
  invoiceNumber String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  license     License?
  settings    Settings?
  apiKey      ApiKeyPool?
  googleCalendarCredential GoogleCalendarCredential?

  planChangeRequests PlanChangeRequest[]
}

model PlanChangeRequest {
  id            Int               @id @default(autoincrement())

  companyId     Int
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  targetPlan    Plan

  paymentMethod PaymentMethod

  status        PlanChangeStatus  @default(PENDING)

  requestedAt   DateTime          @default(now())
  approvedAt    DateTime?
}

model ApiKeyPool {
  id         Int       @id @default(autoincrement())

  provider   String    @default("GEMINI")

  apiKey     String    @unique

  companyId  Int?      @unique
  company    Company?  @relation(fields: [companyId], references: [id])

  assignedAt DateTime?

  createdAt  DateTime  @default(now())
}

model License {
  id              Int            @id @default(autoincrement())

  companyId       Int            @unique
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  licenseKey      String         @unique

  plan            Plan           @default(FREE)

  status          LicenseStatus  @default(INACTIVE)

  maxOcrPerMonth  Int            @default(30)

  usedOcr         Int            @default(0)

  usedOcrMonth    String?

  activatedAt     DateTime?

  expiresAt       DateTime?

  hasUsedPaidPlan Boolean        @default(false)

  createdAt       DateTime       @default(now())

  updatedAt       DateTime       @updatedAt
}

model Settings {
  id               Int       @id @default(autoincrement())

  companyId        Int       @unique

  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  theme            String    @default("light")

  estimateTerms    String?

  laborRatePerHour Int?

  oilChangeIntervalMonths  Int?
  oilChangeIntervalKm      Int?
  tireChangeIntervalMonths Int?
  tireChangeIntervalKm     Int?

  reservationSlotMinutes     Int @default(60)
  reservationLeadHours       Int @default(24)
  reservationMaxAdvanceDays  Int @default(30)

  bankName          String?
  bankBranchName    String?
  bankAccountType   String?
  bankAccountNumber String?
  bankAccountHolder String?

  createdAt        DateTime  @default(now())

  updatedAt        DateTime  @updatedAt
}

model GoogleCalendarCredential {
  id                   Int       @id @default(autoincrement())

  companyId            Int       @unique
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  calendarId           String?
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  connectedEmail       String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model BusinessHours {
  id        Int      @id @default(autoincrement())

  weekday   Int      @unique
  isClosed  Boolean  @default(false)
  startTime String?
  endTime   String?
  breakStartTime String?
  breakEndTime   String?
}

model ClosedDate {
  id     Int      @id @default(autoincrement())

  date   DateTime @unique @db.Date
  reason String?
}

model FeeRate {
  id              Int             @id @default(autoincrement())

  vehicleCategory VehicleCategory
  itemName        String

  price           Int             @default(0)
  sortOrder       Int             @default(0)

  // 車検見積の自動入力時、部品代(unitPrice)と技術料(laborCost)のどちらとして
  // EstimateItemに反映するかを分けるためのフラグ
  isLaborItem     Boolean         @default(false)

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([vehicleCategory, itemName])
}
model Customer {
  id              Int      @id @default(autoincrement())

  customerName    String
  // customerNameの読み仮名(ひらがな)。登録・編集のたびに自動計算して保存し、
  // 「かさい」で「葛西」を検索できるようにする(検索のたびに変換すると重いため事前計算)
  customerNameReading String?
  customerAddress String?

  ownerName       String?
  ownerAddress    String?

  phone           String?

  lineUserId      String?  @unique
  lineLinkToken   String?  @unique

  // スタッフがLINEへ直接手動メッセージを送った後、しばらくAIの自動応答を止めておく期限
  aiPausedUntil   DateTime?
  // 「担当者が対応中です」の案内を今のスタッフ対応中にもう送ったか(1回だけ送るためのマーカー)
  aiPauseNoticeSentAt DateTime?
  // スタッフがこの顧客とのLINE画面を最後に開いていた(ポーリングしていた)時刻。在席判定に使う
  lineScreenViewedAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicles        Vehicle[]
  reservations    Reservation[]
  estimates       Estimate[]
  lineMessages    LineMessage[]
  lineOcrSubmissions LineOcrSubmission[]
  competitorEstimates CompetitorEstimate[]
}

model Vehicle {
  id                 Int       @id @default(autoincrement())

  customerId         Int?

  customer           Customer? @relation(fields: [customerId], references: [id])

  vin                String    @unique

  registrationNumber String?

  ownerName          String?
  ownerAddress       String?

  userName           String?
  userAddress        String?

  usageBase          String?

  carName            String?
  commonModelName    String?
  model              String?
  engineModel        String?

  modelCode          String?
  classificationCode String?

  firstRegistration  String?
  expirationDate     String?
  shakenReminderDismissedFor String?
  shakenReminderDismissReason String?
  oilReminderDismissedFor   String?
  tireReminderDismissedFor  String?

  vehicleWeight      String?
  grossWeight        String?

  seatingCapacity    String?
  maxLoad            String?

  length             String?
  width              String?
  height             String?

  displacement       String?
  fuel               String?

  usage              String?
  privateBusiness    String?

  bodyType           String?
  remarks            String?

  createdAt          DateTime  @default(now())

  updatedAt          DateTime  @updatedAt

  serviceHistories   ServiceHistory[]
  estimates          Estimate[]
  reservations       Reservation[]
  tireMeasurements   TireMeasurement[]
  competitorEstimates CompetitorEstimate[]
}

/**
 * 顧客が他店舗で受け取った見積書をスキャンして保存したもの。スタッフがスキャンした場合は
 * 常にsharedWithShop=trueで両者から見える。顧客がスキャンした場合はsharedWithShopを
 * 顧客自身が選べ、falseなら顧客のポータルにしか出さない(店舗側の一覧には出さない)。
 */
model CompetitorEstimate {
  id             Int      @id @default(autoincrement())

  vehicleId      Int
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  customerId     Int
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  imageData      Bytes
  mimeType       String

  shopName       String?
  estimateDate   String?
  items          Json?
  totalAmount    Int?
  note           String?

  createdBy      String   // 'STAFF' | 'CUSTOMER'
  sharedWithShop Boolean  @default(true)

  createdAt      DateTime @default(now())
}

model TireMeasurement {
  id           Int      @id @default(autoincrement())

  vehicleId    Int
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  date         DateTime
  position     String
  tireType     String   @default("SUMMER")
  isNewTire    Boolean  @default(false)
  treadDepthMm Float
  mileage      Int?
  note         String?

  createdAt    DateTime @default(now())
}

model ServiceHistory {
  id         Int       @id @default(autoincrement())

  vehicleId  Int
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  date       DateTime
  title      String

  mileage    Int?
  category   String[]

  voided          Boolean          @default(false)
  correctedFromId Int?
  correctedFrom   ServiceHistory?  @relation("Correction", fields: [correctedFromId], references: [id])
  corrections     ServiceHistory[] @relation("Correction")

  visibleInPortal Boolean          @default(true)

  items      ServiceHistoryItem[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ChatMessage {
  id        Int      @id @default(autoincrement())

  role      String
  content   String

  createdAt DateTime @default(now())
}

model LineMessage {
  id         Int      @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  direction  String
  text       String

  lineOcrSubmissionId Int?

  readAt     DateTime?

  createdAt  DateTime @default(now())
}

model LineOcrSubmission {
  id              Int       @id @default(autoincrement())

  customerId      Int
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  imageData       Bytes
  mimeType        String
  extractedData   Json

  status          String    @default("PENDING")
  linkedVehicleId Int?

  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?
}

model Announcement {
  id        Int       @id @default(autoincrement())

  title     String
  body      String

  publishAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ServiceHistoryItem {
  id                Int             @id @default(autoincrement())

  serviceHistoryId  Int
  serviceHistory    ServiceHistory  @relation(fields: [serviceHistoryId], references: [id], onDelete: Cascade)

  name              String
  cost              Int             @default(0)

  quantity          Float           @default(1)
  unitPrice         Int             @default(0)
  laborCost         Int             @default(0)
  isFee             Boolean         @default(false)
}

model Estimate {
  id         Int       @id @default(autoincrement())

  vehicleId  Int?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  customerId          Int?
  customer            Customer? @relation(fields: [customerId], references: [id])

  customerNameFreeText String?
  vehicleDescription    String?

  date       DateTime  @default(now())
  title      String

  category   EstimateCategory @default(GENERAL)
  staffName  String?

  items      EstimateItem[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model EstimateItem {
  id          Int       @id @default(autoincrement())

  estimateId  Int
  estimate    Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  name        String
  cost        Int       @default(0)

  quantity    Float     @default(1)
  unitPrice   Int       @default(0)
  laborCost   Int       @default(0)
  isFee       Boolean   @default(false)
}

model Reservation {
  id              Int               @id @default(autoincrement())

  customerId      Int
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  vehicleId       Int?
  vehicle         Vehicle?          @relation(fields: [vehicleId], references: [id])

  status          ReservationStatus @default(PENDING)
  category        String?
  needsLoanerCar  Boolean?

  scheduledStart  DateTime
  scheduledEnd    DateTime

  staffNote       String?
  declineReason   String?

  icsToken        String            @unique
  googleEventId   String?
  reminderSentAt  DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}