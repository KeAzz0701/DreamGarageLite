generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/master-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_MASTER")
}

// 運営者本人が「自分のLINE」として管理画面から登録したLINEユーザーID。
// エラー報告などの運営者向けシステム通知は、ここに登録されている人にだけ送る。
// 以前は環境変数(SYSTEM_ADMIN_LINE_USER_ID)を手動設定していたが、
// 「Dream Garageの社員として連携したIDを流用する」という間に合わせだったため、
// 管理画面から正式に登録できるこの仕組みに置き換える。
model SystemAdminLine {
  id           Int      @id @default(autoincrement())
  lineUserId   String   @unique
  registeredAt DateTime @default(now())
}

// 運営管理画面で会社を作成した際、その場でQRコードとして発行する自動ログイン用トークン。
// 会社パスワードそのものをQRコードやURLに含めない(漏えい時の被害範囲を24時間・その会社のみに
// 限定するため)代わりに、この使い捨てトークンをスキャンすると自動でログインできるようにする。
model CompanyAutoLoginToken {
  id               Int            @id @default(autoincrement())
  token            String         @unique
  companyAccountId Int
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  createdAt        DateTime       @default(now())
}

model CompanyAccount {
  id           Int      @id @default(autoincrement())

  companyCode  String   @unique
  passwordHash String

  displayName  String

  dbName       String   @unique

  lineChannelId          String?
  lineChannelSecret      String?
  lineChannelAccessToken String?
  lineDestinationUserId  String?  @unique

  staffJoinCode String? @unique

  currentPlan  String?

  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKey       ApiKeyPool?
  lineLinks    LineCompanyLink[]
  staffLineLinks LineStaffLink[]
  errorReports ErrorReport[]
  autoLoginTokens CompanyAutoLoginToken[]
}

// 全社共有のGemini APIキープール。会社ごとにDBが分かれているため、
// このキー管理だけは会社を横断できるようマスターDB側に置く。
model ApiKeyPool {
  id               Int             @id @default(autoincrement())

  provider         String          @default("GEMINI")
  tier             String          @default("FREE")

  apiKey           String          @unique

  companyAccountId Int?            @unique
  companyAccount   CompanyAccount? @relation(fields: [companyAccountId], references: [id])

  assignedAt       DateTime?

  createdAt        DateTime        @default(now())
}

// 全社共有のLINE公式アカウント経由で、1人のLINEユーザーが複数社と連携できるようにする
// 横断インデックス。実際の顧客データ(Customer)は各社のテナントDBに残したまま、
// 「このLINEユーザーはどの会社と連携しているか」だけをここで引く。
model LineCompanyLink {
  id               Int            @id @default(autoincrement())

  lineUserId       String

  companyAccountId Int
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id])

  tenantCustomerId Int

  linkedAt         DateTime       @default(now())
  lastActiveAt     DateTime       @default(now())

  @@unique([lineUserId, companyAccountId])
}

// 社員用のLINE連携。会社に1つの参加コード(staffJoinCode)を共有して使う。
// 顧客(LineCompanyLink)とは別枠で、毎朝の一括通知の送信先として使う。
// staffAccessCodeはガレージ・カルテへのログイン(入室ID)にも使う個人別の合言葉。
model LineStaffLink {
  id               Int            @id @default(autoincrement())

  lineUserId       String
  displayName      String?

  companyAccountId Int
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id])

  staffAccessCode  String?        @unique
  lastActiveAt     DateTime       @default(now())

  joinedAt         DateTime       @default(now())

  @@unique([lineUserId, companyAccountId])
}

// デモプレイ版の会社が「エラー報告」ボタンで送った不具合報告。運営(自分自身)のLINEに
// 即時プッシュ通知しつつ、後からまとめて見返せるようここにも保存する。
model ErrorReport {
  id               Int            @id @default(autoincrement())

  companyAccountId Int
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id])
  companyName      String

  pageUrl          String
  pageLabel        String?
  userAgent        String?
  message          String?

  screenshotData     Bytes?
  screenshotMimeType String?

  resolved         Boolean        @default(false)
  resolvedNote     String?
  resolvedAt       DateTime?

  // 自動診断エージェント(スケジュール実行)が調査した原因・修正方針。実際のコード変更は行わず、
  // ここに書かれた内容を運営者本人が管理画面で確認し、デプロイするかどうかを判断する
  diagnosisNote        String?
  diagnosisSuggestedFix String?
  diagnosedAt          DateTime?

  // 運営者が診断結果(原因・修正方針)を見て、採用するか却下するかを管理画面から記録する。
  // null=未判定、APPROVED=採用、REJECTED=却下
  diagnosisVerdict     String?
  diagnosisVerdictAt   DateTime?

  createdAt        DateTime       @default(now())
}

// 運営管理画面(/admin)にログインする担当者アカウント。ADMIN_PASSWORD(共有パスワード)の
// 代わりに、担当者ごとの個別ログインを可能にする。
model AdminUser {
  id           Int      @id @default(autoincrement())

  username     String   @unique
  passwordHash String

  displayName  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
